From 98edcdc7529f5c6eb72dc6a08c7061f90e58712e Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 24 Oct 2026 15:13:20 +1100
Subject: [PATCH] set_passed_properties: bind arguments with a signature made
 once per function

inspect.getcallargs inspects the function's signature on every call. The
decorator now makes an inspect.Signature when it is applied and binds each
call's arguments to it. make_connection_table for a lab's drop_mot experiment
(56 decorated __init__ calls) takes 1.2 ms instead of 2.6 ms, and 20 compiled
shots are identical to those compiled before the change in every dataset and
attribute.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_012E5FGDFW9HEH6h6shrHpsD
---
 labscript/utils.py | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/labscript/utils.py b/labscript/utils.py
index 456abc1..6d3c03a 100644
--- a/labscript/utils.py
+++ b/labscript/utils.py
@@ -14,7 +14,7 @@
 """Utility functions"""
 
 import contextlib
-from inspect import getcallargs
+from inspect import signature
 from functools import wraps
 
 import numpy as np
@@ -108,13 +108,17 @@ def set_passed_properties(property_names=None):
     property_names = property_names or {}
 
     def decorator(func):
+        func_signature = signature(func, follow_wrapped=False)
+
         @wraps(func)
         def new_function(inst, *args, **kwargs):
 
             return_value = func(inst, *args, **kwargs)
 
             # Get a dict of the call arguments/keyword arguments by name:
-            call_values = getcallargs(func, inst, *args, **kwargs)
+            bound_arguments = func_signature.bind(inst, *args, **kwargs)
+            bound_arguments.apply_defaults()
+            call_values = bound_arguments.arguments
 
             all_property_names = set()
             for names in property_names.values():
