From 5fb5b6a428682287ec9e473f7068ec825b0a606d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 17 Oct 2026 10:46:53 +0000
Subject: [PATCH] IMAQdxCamera: restore the saved view range exactly and drop
 the pre-0.11 pyqtgraph workaround

Pull request #63 saves and restores the image view's ranges, auto-range flags
and colour levels. Restoring the ranges with ViewBox.setRange() used the
default padding, so every restore enlarged the visible range by the padding
fraction (20% in total at the default) and the view zoomed out a step on every
BLACS restart. The ranges are now restored with no padding and round-trip
exactly.

The saved ranges and levels are converted to Python floats: BLACS stores tab
save data with repr() and restores it with eval(), and the repr of a numpy
scalar does not evaluate there. The nonzero pixel written into the placeholder
image, a workaround for a histogram error in pyqtgraph before 0.11, is removed.

Verified with PySide6 6.12.0, pyqtgraph 0.14.0 and Python 3.14 on an offscreen
Qt platform: the module imports and compiles; get_save_data and
restore_save_data were run on a pyqtgraph ImageView after displaying a frame,
zooming, panning, enabling auto-range on one axis and setting the levels. The
saved dictionary survives repr and eval unchanged, and a fresh view restored
from it has the same target ranges, auto-range flags and levels; the first
frame displayed afterwards keeps them. A three-image stack and save data
without the new keys were also restored without error.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01C99RPsoP9t5Tb3B8h8pwSM
---
 labscript_devices/IMAQdxCamera/blacs_tabs.py | 22 +++++++-------------
 1 file changed, 8 insertions(+), 14 deletions(-)

diff --git a/labscript_devices/IMAQdxCamera/blacs_tabs.py b/labscript_devices/IMAQdxCamera/blacs_tabs.py
index a9fea69..dab6618 100644
--- a/labscript_devices/IMAQdxCamera/blacs_tabs.py
+++ b/labscript_devices/IMAQdxCamera/blacs_tabs.py
@@ -186,10 +186,11 @@ class IMAQdxCameraTab(DeviceTab):
             # Get the view_box to access its settings.
             view_box = self.image.getImageItem().getViewBox()
 
-            # Save x and y ranges.
+            # Save x and y ranges. BLACS stores save data with repr() and restores it
+            # with eval(), so numpy scalars are converted to Python floats.
             targetRange_x, targetRange_y = view_box.targetRange()
-            save_data['targetRange_x'] = targetRange_x
-            save_data['targetRange_y'] = targetRange_y
+            save_data['targetRange_x'] = [float(x) for x in targetRange_x]
+            save_data['targetRange_y'] = [float(y) for y in targetRange_y]
 
             # Save whether the x and y ranges are automatically adjusted.
             autoRange_x, autoRange_y = view_box.autoRangeEnabled()
@@ -198,8 +199,8 @@ class IMAQdxCameraTab(DeviceTab):
 
             # Save color scale limits.
             color_scale_min, color_scale_max = self.image.getLevels()
-            save_data['color_scale_min'] = color_scale_min
-            save_data['color_scale_max'] = color_scale_max
+            save_data['color_scale_min'] = float(color_scale_min)
+            save_data['color_scale_max'] = float(color_scale_max)
 
         return save_data
 
@@ -220,18 +221,10 @@ class IMAQdxCameraTab(DeviceTab):
         if 'image_shape' in save_data and 'image_dtype' in save_data:
             # Some image must be displayed now, otherwise the plot settings will
             # be overwritten once the first image is displayed. We'll display a
-            # mostly blank image of the saved size and data type.
+            # blank image of the saved size and data type.
             image_shape = ast.literal_eval(save_data['image_shape'])
             image_dtype = np.dtype(save_data['image_dtype'])
             dummy_image = np.zeros(image_shape, dtype=image_dtype)
-            # Make one pixel nonzero to avoid a histogram binning error. This is
-            # fixed by in pyqtgraph 0.11 by
-            # https://github.com/pyqtgraph/pyqtgraph/pull/767 but this
-            # workaround is retained for compatibility with older versions.
-            if dummy_image.ndim == 2:
-                dummy_image[0, 0] = 1
-            if dummy_image.ndim == 3:
-                dummy_image[:, 0, 0] = 1
             self.image.setImage(dummy_image)
 
             # Restore x and y ranges.
@@ -240,6 +233,7 @@ class IMAQdxCameraTab(DeviceTab):
                 view_box.setRange(
                     xRange=save_data['targetRange_x'],
                     yRange=save_data['targetRange_y'],
+                    padding=0,
                 )
             except KeyError:
                 pass
