@@ -189,22 +215,15 @@ def make_single_run_file(filename, sequenceglobals, runglobals, sequence_attrs,
         f.attrs.update(sequence_attrs)
         f.attrs['run number'] = run_no
         f.attrs['n_runs'] = n_runs
-        f.create_group('globals')
