From e205724d67b7c7ab0c635f12aa3296429919234f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 17 Oct 2026 10:46:53 +0000
Subject: [PATCH] IMAQdxCamera: guard background subtraction against missing or
 mismatched frames

Pull request #87 adds display-side background subtraction to the IMAQdxCamera
BLACS tab. Two cases raised in the main thread:

- "Set background" before any frame had been received: set_bg_image() stored
  None as the background and update_image() then called swapaxes on None.
- A frame of a different shape from the background (after an ROI change, or a
  stack with a different number of images): the subtraction raised ValueError
  after the worker had already been sent its acknowledgement.

set_bg_image() now does nothing and returns False when no frame has been
received, and the tab leaves the buttons unchanged in that case. update_image()
returns when there is no frame, and subtracts the background only when its
shape matches the trailing dimensions of the frame, so a 2-D background is also
subtracted from each image of a stack sent after a shot; frames of any other
shape are displayed unsubtracted. The "Set background" tooltip now says that
the subtraction affects the display only and not the images saved to shot
files.

Verified with PySide6 6.12.0, pyqtgraph 0.14.0 and Python 3.14 on an offscreen
Qt platform, on this branch merged with master: the module imports and
compiles; an ImageReceiver with a real pyqtgraph ImageView was given "set
background" with no frame (no error, buttons unchanged), a frame, "set
background" (the display becomes zero), a frame of a different shape (displayed
unchanged), a frame of the same shape (displayed with the background
subtracted), a three-image stack (background subtracted from each image), a
2-D frame with a 3-D background (displayed unchanged) and "clear background".
A frame sent over ZMQ as the worker sends it was acknowledged and displayed.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01C99RPsoP9t5Tb3B8h8pwSM
---
 labscript_devices/IMAQdxCamera/blacs_tab.ui  |  2 +-
 labscript_devices/IMAQdxCamera/blacs_tabs.py | 19 +++++++++++++++----
 2 files changed, 16 insertions(+), 5 deletions(-)

diff --git a/labscript_devices/IMAQdxCamera/blacs_tab.ui b/labscript_devices/IMAQdxCamera/blacs_tab.ui
index 4a6542e..bb4ba5f 100644
--- a/labscript_devices/IMAQdxCamera/blacs_tab.ui
+++ b/labscript_devices/IMAQdxCamera/blacs_tab.ui
@@ -64,7 +64,7 @@
        <item>
         <widget class="QPushButton" name="pushButton_set_bg">
          <property name="toolTip">
-          <string>Set current image as the background, to be subtracted from displayed images</string>
+          <string>Set the current image as the background, which is subtracted from displayed images. This affects the display only, not the images saved to shot files.</string>
          </property>
          <property name="text">
           <string>Set background</string>
diff --git a/labscript_devices/IMAQdxCamera/blacs_tabs.py b/labscript_devices/IMAQdxCamera/blacs_tabs.py
index 0dd52ac..0a1e943 100644
--- a/labscript_devices/IMAQdxCamera/blacs_tabs.py
+++ b/labscript_devices/IMAQdxCamera/blacs_tabs.py
@@ -105,9 +105,14 @@ class ImageReceiver(ZMQServer):
 
     @inmain_decorator(wait_for_return=True)
     def update_image(self):
+        if self.image is None:
+            return
         image = self.image
-        if self.bg_image is not None:
-            image = self.image.astype(float) - self.bg_image.astype(float)
+        bg_image = self.bg_image
+        if bg_image is not None and image.shape[-bg_image.ndim:] == bg_image.shape:
+            # Subtract the background from the image, or from each image of a stack, if
+            # the shapes match:
+            image = image.astype(float) - bg_image.astype(float)
         autolevels = self.autolevels_button.isChecked()
         if self.image_view.image is None:
             # First time setting an image. Do autoscaling etc:
@@ -120,10 +125,15 @@ class ImageReceiver(ZMQServer):
                 autoHistogramRange=autolevels,
             )
 
-    @inmain_decorator()
+    @inmain_decorator(wait_for_return=True)
     def set_bg_image(self):
+        """Use the most recently received image as the background. Returns False if no
+        image has been received yet."""
+        if self.image is None:
+            return False
         self.bg_image = self.image
         self.update_image()
+        return True
 
     @inmain_decorator()
     def clear_bg_image(self):
@@ -293,7 +303,8 @@ class IMAQdxCameraTab(DeviceTab):
         self.stop_continuous()
 
     def on_set_bg_clicked(self, button):
-        self.image_receiver.set_bg_image()
+        if not self.image_receiver.set_bg_image():
+            return
         self.ui.pushButton_set_bg.hide()
         self.ui.pushButton_clear_bg.show()
 
